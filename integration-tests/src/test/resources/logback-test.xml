<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{svc:-}%thread] %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
    <!-- the saga itself -->
    <logger name="com.example.saga" level="INFO"/>
    <logger name="org.testcontainers" level="INFO"/>
</configuration>
